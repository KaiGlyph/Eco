{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v2.0.0-rc.0/tooling/cli/schema.json",
  "productName": "Eco",
  "version": "1.2.0",
  "identifier": "com.eco.asistente",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eco - Asistente IA",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/eco-backend/**/*",
      "resources/whisper-cli.exe",
      "resources/ggml-base.bin"
    ]
  }
}